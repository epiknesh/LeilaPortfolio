---
import { getPublicImageSize, toWebpPath, toThumbPath } from '../lib/image-size';

type GalleryImage = { image: string; size: 'standard' | 'wide' | 'portrait' | 'full' };

interface Props {
  images: GalleryImage[];
  altPrefix: string;
}

const { images, altPrefix } = Astro.props;

// The grid thumbnail uses the small (640px-capped) thumb variant — it was
// previously using the same full 2000px .webp the lightbox's zoomed-in
// view needs, meaning every gallery tile downloaded/decoded a far larger
// image than its on-screen size ever needed. data-full-src (what the
// lightbox actually opens to) still points at the full-size version via
// toWebpPath(). Real dimensions are still read for the thumbnail's width/
// height attributes, to avoid layout shift while the grid loads.
const gallery = await Promise.all(
  images.map(async ({ image: src, size }) => {
    const { width, height, ok } = await getPublicImageSize(src);
    return { src, thumb: toThumbPath(src), full: toWebpPath(src), width, height, size, ok };
  })
);
---

<div class="lightbox-gallery" data-lightbox-root>
  <div class="gallery-grid">
    {gallery.map(({ src, thumb, full, width, height, size, ok }, i) => (
      ok ? (
        <button
          type="button"
          class={`gallery-trigger size-${size}`}
          data-lightbox-open
          data-skeleton-container
          data-index={i}
          data-full-src={full}
          data-full-alt={`${altPrefix}, image ${i + 1} of ${images.length}`}
          aria-label={`Open image ${i + 1} of ${images.length} full size`}
        >
          <picture>
            <source srcset={thumb} type="image/webp" />
            <img src={src} width={width} height={height} alt={`${altPrefix}, image ${i + 1} of ${images.length}`} loading="lazy" decoding="async" class="gallery-image" data-skeleton-img />
          </picture>
        </button>
      ) : (
        <div class={`gallery-trigger missing-image size-${size} font-mono`} aria-hidden="true">
          [ image missing: {src.split('/').pop()} ]
        </div>
      )
    ))}
  </div>

  <div class="lightbox-overlay grain" data-lightbox-overlay hidden>
    <div class="lightbox-chrome">
      <span class="lightbox-index font-mono" data-lightbox-caption></span>
      <button type="button" class="lightbox-close font-mono" data-lightbox-close aria-label="Close">close ✕</button>
    </div>

    <div class="lightbox-stage">
      <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Previous image">
        <span aria-hidden="true">←</span>
      </button>

      <div class="lightbox-frame">
        <img src="" alt="" data-lightbox-image />
      </div>

      <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Next image">
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="lightbox-progress" aria-hidden="true">
      <div class="lightbox-progress-bar" data-lightbox-progress></div>
    </div>
  </div>
</div>

<script>
  function initLightbox(root: HTMLElement) {
    // Astro's View Transitions swap in a fresh DOM for each navigation, but
    // this script tag (and its top-level `initLightbox` call below) only
    // runs once per actual document load unless re-bound to astro:page-load
    // — without the guard+rebind here, a gallery reached via a client-side
    // navigation (grid tile click, prev/next filmstrip) had no listeners
    // attached at all until a manual refresh re-ran the script from scratch.
    if (root.dataset.lightboxInitialized === 'true') return;
    root.dataset.lightboxInitialized = 'true';

    const overlay = root.querySelector<HTMLElement>('[data-lightbox-overlay]');
    const frame = root.querySelector<HTMLElement>('.lightbox-frame');
    const imgEl = root.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const captionEl = root.querySelector<HTMLElement>('[data-lightbox-caption]');
    const progressEl = root.querySelector<HTMLElement>('[data-lightbox-progress]');
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-next]');

    if (!overlay || !frame || !imgEl || !captionEl || !progressEl || triggers.length === 0) return;

    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;
    let isAnimating = false;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function updateChrome(index: number) {
      captionEl!.textContent = `${String(index + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;
      progressEl!.style.width = `${((index + 1) / triggers.length) * 100}%`;
    }

    function loadImage(index: number) {
      const trigger = triggers[index];
      const fullSrc = trigger.dataset.fullSrc;
      const fullAlt = trigger.dataset.fullAlt;
      if (!fullSrc || !imgEl) return;
      imgEl.src = fullSrc;
      imgEl.alt = fullAlt ?? '';
    }

    function show(index: number, direction: 1 | -1 | 0 = 0) {
      const nextIndex = (index + triggers.length) % triggers.length;
      if (nextIndex === currentIndex && overlay!.hidden === false && direction === 0) return;

      if (isAnimating || prefersReducedMotion || direction === 0) {
        currentIndex = nextIndex;
        loadImage(currentIndex);
        updateChrome(currentIndex);
        return;
      }

      isAnimating = true;
      frame!.classList.add(direction > 0 ? 'is-leaving-left' : 'is-leaving-right');

      window.setTimeout(() => {
        currentIndex = nextIndex;
        loadImage(currentIndex);
        updateChrome(currentIndex);
        frame!.classList.remove('is-leaving-left', 'is-leaving-right');
        frame!.classList.add(direction > 0 ? 'is-entering-from-right' : 'is-entering-from-left');
        // Force reflow so the entering transition actually runs.
        void frame!.offsetWidth;
        frame!.classList.remove('is-entering-from-right', 'is-entering-from-left');
        isAnimating = false;
      }, 180);
    }

    // Matches the CSS transition-duration on .lightbox-overlay below.
    const OVERLAY_TRANSITION_MS = prefersReducedMotion ? 0 : 260;

    function open(index: number) {
      lastFocused = document.activeElement as HTMLElement;
      currentIndex = index;
      loadImage(currentIndex);
      updateChrome(currentIndex);
      overlay!.hidden = false;
      // Force a layout flush between removing [hidden] and adding the
      // "visible" class, so the browser treats the opacity/scale change as
      // a transition to animate rather than a same-frame jump straight to
      // the end state.
      void overlay!.offsetWidth;
      overlay!.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function close() {
      overlay!.classList.remove('is-visible');
      document.body.style.overflow = '';
      lastFocused?.focus();
      window.setTimeout(() => {
        overlay!.hidden = true;
      }, OVERLAY_TRANSITION_MS);
    }

    triggers.forEach((trigger, i) => {
      trigger.addEventListener('click', () => open(i));
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => show(currentIndex - 1, -1));
    nextBtn?.addEventListener('click', () => show(currentIndex + 1, 1));

    // Close on any click that lands outside the image and the prev/next
    // buttons — not just a click on the overlay's own background. The
    // stage/chrome/progress-bar areas around the image count as "outside"
    // too, so clicking anywhere that isn't the photo or a nav control
    // closes the lightbox, same as clicking the dimmed backdrop already did.
    overlay.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const clickedImage = target === imgEl;
      const clickedNav = target.closest('.lightbox-nav') !== null;
      if (!clickedImage && !clickedNav) close();
    });

    document.addEventListener('keydown', (e) => {
      if (overlay!.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(currentIndex - 1, -1);
      if (e.key === 'ArrowRight') show(currentIndex + 1, 1);
      if (e.key === 'Tab') trapFocus(e);
    });

    function trapFocus(e: KeyboardEvent) {
      const focusable = overlay!.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  function initAllLightboxes() {
    document.querySelectorAll<HTMLElement>('[data-lightbox-root]').forEach(initLightbox);
  }

  initAllLightboxes();
  document.addEventListener('astro:page-load', initAllLightboxes);
</script>

<style>
  /*
    A project's gallery mixes images of genuinely different shapes (a single
    dramatic wide render, a tall portrait crop, a square detail shot) — an
    explicit 12-column grid lets each image's own `size` (set per-image in
    the CMS, see src/content/config.ts) claim the right amount of width
    instead of forcing every image into the same tile regardless of its
    actual composition. `standard`/`portrait` both sit in a 6-column (half-
    width) slot on desktop since the difference between them is aspect
    ratio, not width; `wide` takes 8 columns; `full` takes all 12.
  */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
  }

  .gallery-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    font: inherit;
    color: inherit;
    grid-column: span 6;
    overflow: hidden;
    position: relative;
  }
  .gallery-trigger.size-wide { grid-column: span 8; }
  .gallery-trigger.size-full { grid-column: span 12; }
  .gallery-trigger.size-portrait { grid-column: span 4; }

  .gallery-trigger.missing-image {
    cursor: default;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    border: 1px dashed var(--line);
    background: var(--bg-alt);
    color: var(--text-dim);
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
  }
  .gallery-trigger.missing-image.size-portrait {
    aspect-ratio: 3 / 4;
  }

  /* Skeleton shimmer, same pattern as ProjectCard.astro's .card-image —
     visible until the shared data-skeleton-img handler (BaseLayout.astro)
     marks this tile .is-loaded. */
  .gallery-trigger:not(.missing-image)::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 1;
    transition: opacity var(--dur-standard) var(--ease-standard);
    background: linear-gradient(
      100deg,
      transparent 30%,
      color-mix(in srgb, var(--bg-alt) 40%, white 25%) 50%,
      transparent 70%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.6s ease-in-out infinite;
    pointer-events: none;
  }
  .gallery-trigger.is-loaded::after { opacity: 0; animation: none; }
  @media (prefers-reduced-motion: reduce) {
    .gallery-trigger::after { animation: none; }
  }

  /* <picture> defaults to display:inline, which sizes it to the <img>'s
     own intrinsic dimensions instead of stretching to fill the grid cell
     — without this, each gallery tile shows its image at a tiny, oddly
     placed size inside a mostly-empty box instead of actually filling the
     width its `size` class claims. Same root cause/fix as the project-card
     thumbnail letterboxing bug fixed earlier. */
  .gallery-trigger picture {
    display: block;
    width: 100%;
  }

  .gallery-trigger:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  .gallery-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--dur-standard) var(--ease-standard), filter var(--dur-standard) var(--ease-standard),
      opacity var(--dur-standard) var(--ease-standard);
  }
  .gallery-trigger:not(.is-loaded) .gallery-image[data-skeleton-img] { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .gallery-image[data-skeleton-img] { transition: none; }
  }
  .gallery-trigger.size-portrait .gallery-image {
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  .gallery-trigger:hover .gallery-image,
  .gallery-trigger:focus-visible .gallery-image {
    transform: scale(1.035);
    filter: brightness(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-image { transition: none; }
    .gallery-trigger:hover .gallery-image,
    .gallery-trigger:focus-visible .gallery-image {
      transform: none;
    }
  }
  @media (hover: none) {
    .gallery-trigger:hover .gallery-image { transform: none; filter: none; }
  }

  @media (max-width: 760px) {
    .gallery-trigger,
    .gallery-trigger.size-wide,
    .gallery-trigger.size-portrait,
    .gallery-trigger.size-full {
      grid-column: span 12;
    }
    .gallery-trigger.size-portrait .gallery-image {
      aspect-ratio: auto;
      height: auto;
    }
  }

  /* ---------- overlay shell ----------
     Always a dark overlay regardless of the page's own (now flat) background —
     these --lb-* tokens are scoped to the lightbox only. */
  .lightbox-overlay {
    --lb-text-dim: #A39D94;
    --lb-line: rgba(255, 255, 255, 0.15);
    --lb-accent: #C6645B;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--ink);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 260ms var(--ease-standard), transform 260ms var(--ease-standard);
  }
  /* [hidden] still applies instantly (display:none) so the overlay is
     removed from layout/tab order once the close transition finishes —
     the JS delays setting [hidden] until after OVERLAY_TRANSITION_MS so
     the opacity/transform change above gets to actually animate first. */
  .lightbox-overlay[hidden] { display: none; }
  .lightbox-overlay.is-visible {
    opacity: 1;
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-overlay {
      transition: none;
      transform: none;
    }
  }

  /* ---------- top chrome: index + close, fixed position, never moves ---------- */
  .lightbox-chrome {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px clamp(16px, 4vw, 32px);
  }
  .lightbox-index {
    font-size: var(--fs-caption);
    letter-spacing: 0.1em;
    color: var(--lb-text-dim);
    font-variant-numeric: tabular-nums;
  }
  .lightbox-close {
    background: none;
    border: none;
    color: var(--lb-text-dim);
    font-size: var(--fs-caption);
    letter-spacing: 0.08em;
    cursor: pointer;
    padding: 6px 4px;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .lightbox-close:hover { color: var(--pink); }
  .lightbox-close:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  /* ---------- stage: fixed-height flex row, image never shifts layout ---------- */
  .lightbox-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 2vw, 24px);
    padding-inline: clamp(8px, 3vw, 24px);
    padding-bottom: 20px;
  }

  .lightbox-frame {
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .lightbox-frame img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    transition: opacity 180ms var(--ease-standard), transform 180ms var(--ease-standard);
  }
  .lightbox-frame.is-leaving-left img { opacity: 0; transform: translateX(-24px); }
  .lightbox-frame.is-leaving-right img { opacity: 0; transform: translateX(24px); }
  .lightbox-frame.is-entering-from-right img { opacity: 0; transform: translateX(24px); }
  .lightbox-frame.is-entering-from-left img { opacity: 0; transform: translateX(-24px); }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-frame img { transition: none; }
  }

  .lightbox-nav {
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--lb-line);
    color: var(--lb-text-dim);
    width: 44px;
    height: 44px;
    border-radius: 2px;
    cursor: pointer;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
  }
  .lightbox-nav:hover {
    color: var(--pink);
    border-color: var(--pink);
  }
  .lightbox-nav:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  /* ---------- progress rule: quiet, doesn't jump, sits at the very bottom ---------- */
  .lightbox-progress {
    flex-shrink: 0;
    height: 1px;
    background: var(--lb-line);
  }
  .lightbox-progress-bar {
    height: 100%;
    background: var(--lb-accent);
    transition: width var(--dur-standard) var(--ease-standard);
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-progress-bar { transition: none; }
  }

  @media (max-width: 640px) {
    .lightbox-nav {
      width: 36px;
      height: 36px;
      font-size: 0.95rem;
    }
    .lightbox-stage { gap: 8px; }
  }
</style>
