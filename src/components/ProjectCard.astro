---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { id, data } = project;
const accent = data.palette[0]?.hex ?? '#B32E22';
---

<a
  href={`/work/${id}/`}
  class="project-card"
  data-grid-item
  data-category={data.category}
  style={`--accent: ${accent};`}
>
  <div class="card-image">
    <img
      src={data.cardImage}
      alt=""
      loading="lazy"
      decoding="async"
      transition:name={`project-image-${id}`}
    />
    <div class="card-overlay">
      <h3 class="font-stamp card-title">{data.title}</h3>
      <p class="font-mono card-tag">{data.projectType}</p>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: block;
    position: relative;
  }

  .card-image {
    aspect-ratio: 1 / 1;
    background: color-mix(in srgb, var(--accent) 18%, var(--bg-alt));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hover/focus: darken the image and bring the title + tag up on top of
     it, instead of the title living in a separate block below the image. */
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 24px;
    background: rgba(13, 12, 11, 0);
    opacity: 0;
    transition: background var(--dur-standard) var(--ease-standard),
      opacity var(--dur-standard) var(--ease-standard);
  }
  .project-card:hover .card-overlay,
  .project-card:focus-visible .card-overlay {
    background: rgba(13, 12, 11, 0.55);
    opacity: 1;
  }

  .card-title {
    font-size: 1.7rem;
    text-transform: none;
    letter-spacing: 0;
    color: #EDE8E0;
  }

  .card-tag {
    font-size: var(--fs-caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #EDE8E0;
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-overlay { transition: none; }
  }

  /* On touch devices hover doesn't apply meaningfully; show the overlay
     permanently instead of hiding the title behind a gesture nobody will
     discover. */
  @media (hover: none) {
    .card-overlay {
      background: rgba(13, 12, 11, 0.45);
      opacity: 1;
    }
  }
</style>
