---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SoftwareIcon from '../../components/SoftwareIcon.astro';
import { toTileSrcSet, getPublicImageSize } from '../../lib/image-size';

const software = await getCollection('software');
const byTier = (tier: 'primary' | 'secondary' | 'basic') =>
  software.filter((t) => t.data.tier === tier).sort((a, b) => a.data.order - b.data.order);
const primaryTools = byTier('primary');
const secondaryTools = byTier('secondary');
const basicTools = byTier('basic');

const about = await getEntry('about', 'about');
const { Content } = about ? await render(about) : { Content: null };
const portraitInfo = about
  ? await getPublicImageSize(about.data.portrait)
  : { ok: false, width: 0, height: 0 };
---

<BaseLayout
  title="About"
  description="About Leila Karlene Banta, graphic designer, illustrator, and architecture graduate based in Metro Manila, Philippines."
>
  <section class="section no-reveal about-hero grain">
    <div class="sheet about-hero-grid">
      <div class="portrait-frame">
        {portraitInfo.ok ? (
          <picture>
            <source srcset={toTileSrcSet(about!.data.portrait, portraitInfo.width)} sizes="(max-width: 900px) 100vw, 45vw" type="image/webp" />
            <img
              src={about!.data.portrait}
              alt="Illustrated self-portrait of Leila, hand-drawn in ink with red spiral and star accents"
              class="portrait-image"
              width={portraitInfo.width}
              height={portraitInfo.height}
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        ) : (
          <div class="missing-image font-mono" aria-hidden="true">
            [ image missing{about ? `: ${about.data.portrait.split('/').pop()}` : '' } ]
          </div>
        )}
      </div>
      <div>
        <p class="label">about [me]</p>
        <h1 class="font-stamp hero-title">Leila Karlene<br />Banta</h1>
        <p class="font-body hero-lede">{about?.data.heroLede}</p>
      </div>
    </div>
  </section>

  <section class="section narrative-section grain bg-alt">
    <div class="sheet narrative-grid">
      <div>
        <p class="label">architecture → design</p>
        <h2 class="font-stamp" set:html={(about?.data.narrativeHeading ?? '').replace('\n', '<br />')} />
      </div>
      <div class="narrative-copy font-body">
        {Content && <Content />}
      </div>
    </div>
  </section>

  <section class="section software-section grain">
    <div class="sheet">
      <p class="label">software</p>

      <h3 class="font-stamp tier-title">Primary</h3>
      <div class="tool-grid">
        {primaryTools.map((tool) => (
          <div class="tool-tile">
            <SoftwareIcon icon={tool.data.icon} class="tool-icon" />
            <p class="font-mono tool-name">{tool.data.name}</p>
          </div>
        ))}
      </div>

      <h3 class="font-stamp tier-title" style="margin-top: 44px;">Secondary</h3>
      <div class="tool-grid">
        {secondaryTools.map((tool) => (
          <div class="tool-tile">
            <SoftwareIcon icon={tool.data.icon} class="tool-icon" />
            <p class="font-mono tool-name">{tool.data.name}</p>
          </div>
        ))}
      </div>

      <h3 class="font-stamp tier-title" style="margin-top: 44px;">Basic</h3>
      <div class="tool-grid">
        {basicTools.map((tool) => (
          <div class="tool-tile">
            <SoftwareIcon icon={tool.data.icon} class="tool-icon" />
            <p class="font-mono tool-name">{tool.data.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .portrait-frame {
    aspect-ratio: 3 / 4;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .portrait-frame picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .portrait-frame .missing-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    color: var(--text-dim);
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
  }
  .portrait-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .hero-title {
    font-size: var(--fs-display);
    line-height: 0.95;
    margin-block: 14px 24px;
  }
  .hero-lede {
    font-size: var(--fs-body-lg);
    max-width: 52ch;
    opacity: 0.9;
  }

  .narrative-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(24px, 5vw, 64px);
  }
  /* :global here because <Content /> (the rendered Markdown body from the
     about page's content-collection entry) renders its <p> tags without
     this component's data-astro-cid-* scoping attribute — see the same
     fix/explanation in work/[slug]/index.astro's .description-copy rule. */
  .narrative-copy :global(p) {
    max-width: 62ch;
    margin-bottom: 20px;
    opacity: 0.88;
  }
  .narrative-copy :global(p:last-child) { margin-bottom: 0; }

  .tier-title {
    font-size: 1.1rem;
    text-transform: none;
    letter-spacing: 0;
    margin: 20px 0 16px;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 20px;
    max-width: 640px;
  }
  .tool-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .tool-icon {
    width: 32px;
    height: 32px;
    color: var(--text);
    flex-shrink: 0;
  }
  .tool-name {
    font-size: var(--fs-caption);
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .about-hero-grid,
    .narrative-grid {
      grid-template-columns: 1fr;
    }
    .tool-grid {
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
      gap: 16px;
    }
  }
</style>
