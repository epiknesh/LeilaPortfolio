---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import SoftwareIcon from '../../components/SoftwareIcon.astro';

const contact = await getEntry('contact', 'contact');
const siteInfo = (await getEntry('siteInfo', 'site'))!.data;

const channels = [
  { label: 'email', icon: 'email', value: siteInfo.email, href: `mailto:${siteInfo.email}` },
  { label: 'phone', icon: 'phone', value: siteInfo.phone, href: `tel:${siteInfo.phone.replace(/[^+\d]/g, '')}` },
  { label: 'linkedin', icon: 'linkedin', value: 'linkedin ↗', href: siteInfo.linkedin, external: true },
  { label: 'instagram', icon: 'instagram', value: siteInfo.instagramHandle, href: siteInfo.instagram, external: true },
  { label: 'location', icon: 'location', value: siteInfo.location },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Leila Karlene Banta, graphic designer and illustrator based in Metro Manila, Philippines."
>
  <section class="section no-reveal contact-hero grain">
    <div class="sheet">
      <p class="label">get in touch</p>
      <h1 class="font-stamp contact-heading">Send a message.</h1>
      <p class="font-body contact-lede">
        {contact?.data.lede} <a href={`mailto:${siteInfo.email}`} class="inline-link">{siteInfo.email}</a>.
      </p>

      <div class="contact-layout">
        <div class="form-panel">
          <p class="label form-heading">send a message</p>
          <ContactForm />
        </div>

        <aside class="channels-panel" aria-label="Other ways to reach Leila">
          <p class="label channels-heading">reach her directly</p>
          <ul class="channels-list">
            {channels.map((c) => (
              <li class="channel-row">
                <span class="channel-icon" aria-hidden="true">
                  <SoftwareIcon icon={c.icon} dir="contact" class="tool-icon" />
                </span>
                <div class="channel-text">
                  <span class="channel-label font-mono">{c.label}</span>
                  {c.href ? (
                    <a
                      href={c.href}
                      class="channel-value font-mono"
                      target={c.external ? '_blank' : undefined}
                      rel={c.external ? 'noopener noreferrer' : undefined}
                    >
                      {c.value}
                    </a>
                  ) : (
                    <span class="channel-value font-mono">{c.value}</span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-heading {
    font-size: var(--fs-display);
    line-height: 0.95;
    margin-block: 14px 20px;
    font-style: italic;
  }
  .contact-lede {
    font-size: var(--fs-body-lg);
    color: var(--text-dim);
    max-width: 60ch;
    margin-bottom: var(--space-block);
  }
  .inline-link {
    color: var(--red);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .inline-link:hover { border-color: var(--red); }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }

  .form-heading {
    margin-bottom: 20px;
  }

  .channels-panel {
    border-top: 1px solid var(--line);
    padding-top: clamp(20px, 3vw, 28px);
  }
  .channels-heading {
    margin-bottom: 18px;
  }

  .channels-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .channel-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .channel-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .channel-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--red);
  }
  .channel-icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .channel-label {
    font-size: var(--fs-caption);
    text-transform: lowercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
  }
  .channel-value {
    font-size: var(--fs-body-lg);
    color: var(--text);
  }
  a.channel-value {
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
    width: fit-content;
  }
  a.channel-value:hover {
    color: var(--red);
    border-color: var(--red);
  }

  @media (max-width: 820px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--space-block);
    }
    .channels-panel {
      order: -1;
    }
    /* On mobile the channels list sits above the form (so the most
       scannable info — email/phone/socials — comes first); without its
       own heading and a border above it, the form just looked like a
       continuation of the channels list instead of its own section. */
    .form-panel {
      border-top: 1px solid var(--line);
      padding-top: var(--space-block);
    }
  }
</style>
