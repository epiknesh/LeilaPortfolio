---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SoftwareIcon from '../components/SoftwareIcon.astro';
import { toTileSrcSet, getPublicImageSize } from '../lib/image-size';

const home = await getEntry('home', 'home');
const siteInfo = await getEntry('siteInfo', 'site');
// Both logoImage/typescriptImage are optional — if set, also confirm the
// file actually exists before trying to render it, so a broken reference
// (deleted/renamed file) falls back to the same "not uploaded yet"
// placeholder instead of a broken <img>, rather than needing a third
// visual state just for that case.
const logoInfo = home?.data.logoImage ? await getPublicImageSize(home.data.logoImage) : null;
const typescriptInfo = home?.data.typescriptImage ? await getPublicImageSize(home.data.typescriptImage) : null;
const tierOrder = { primary: 0, secondary: 1, basic: 2 };
const software = (await getCollection('software')).sort((a, b) => {
  const tierDiff = tierOrder[a.data.tier] - tierOrder[b.data.tier];
  return tierDiff !== 0 ? tierDiff : a.data.order - b.data.order;
});
---

<BaseLayout
  title="Portfolio"
  description="Graphic design portfolio of Leila Karlene Banta: branding, digital & social media, editorial, presentation design, creative direction, and 3D/architectural visualization."
>
  <!-- ============ ABOUT INTRO (now the opening section) ============ -->
  <section class="section no-reveal about-intro grain" id="about-intro">
    <div class="sheet about-grid">
      <div>
        <!-- Both logoImage/typescriptImage are optional CMS fields (Homepage
             tab in /admin) — until Leila uploads them (or if a reference is
             set but the file is missing/broken), these render as dashed
             placeholder boxes instead. -->
        {logoInfo?.ok ? (
          <h1 class="about-heading-image">
            <picture>
              <source srcset={toTileSrcSet(home!.data.logoImage!, logoInfo.width)} sizes="min(420px, 100vw)" type="image/webp" />
              <img
                src={home!.data.logoImage}
                alt="Leila Karlene Banta"
                width={logoInfo.width}
                height={logoInfo.height}
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </h1>
        ) : (
          <h1 class="about-heading-placeholder font-mono" aria-label="About me">
            [ logo placeholder — about [me] ]
          </h1>
        )}
        {typescriptInfo?.ok ? (
          <div class="about-sub-image">
            <picture>
              <source srcset={toTileSrcSet(home!.data.typescriptImage!, typescriptInfo.width)} sizes="min(420px, 100vw)" type="image/webp" />
              <img
                src={home!.data.typescriptImage}
                alt=""
                width={typescriptInfo.width}
                height={typescriptInfo.height}
                decoding="async"
              />
            </picture>
          </div>
        ) : (
          <div class="about-sub-placeholder font-mono" aria-label="Software, information">
            [ typescript placeholder — software / information ]
          </div>
        )}
      </div>
      <div class="about-copy">
        <p class="font-body intro-line">{home?.data.introLine}</p>
        <ul class="software-list">
          {software.map((tool) => (
            <li class="software-item" tabindex="0" aria-label={tool.data.name}>
              <span class="software-icon-wrap">
                <SoftwareIcon icon={tool.data.icon} class="software-icon" />
              </span>
              <span class="software-name font-mono" aria-hidden="true">{tool.data.name}</span>
            </li>
          ))}
        </ul>
        <a href="/about/" class="more-link font-mono">more about leila →</a>
      </div>
    </div>
  </section>

  <!-- ============ WORK: FILTERABLE GRID ============ -->
  <section class="section tight-top work-section grain" id="work">
    <div class="sheet">
      <p class="label" style="margin-bottom: 20px;">selected work</p>
      <ProjectGrid />
    </div>
  </section>

  <!-- ============ CONTACT TEASER ============ -->
  <section class="section tight-top contact-section grain" id="contact">
    <div class="sheet contact-inner">
      <div>
        <p class="label">let's work together</p>
        <h2 class="font-stamp contact-heading">Have a project<br />in mind?</h2>
        <p class="font-body contact-lede">
          {siteInfo!.data.email}
        </p>
      </div>
      <a href="/contact/" class="contact-link font-mono">send a message →</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- about intro ---- */
  .about-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(24px, 6vw, 80px);
    align-items: start;
  }
  /* Placeholders for two real assets Leila is producing (a logo and a
     typescript/wordmark of her name) — see the HTML comment above these
     in the markup. Sized roughly to where the final images will sit so
     the layout doesn't jump once they're swapped in. */
  .about-heading-placeholder,
  .about-sub-placeholder {
    display: flex;
    align-items: center;
    border: 1px dashed var(--line);
    background: var(--bg-alt);
    color: var(--text-dim);
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    text-align: center;
    padding: 20px;
  }
  .about-heading-placeholder {
    min-height: 120px;
    margin-bottom: 16px;
  }
  .about-sub-placeholder {
    min-height: 72px;
  }

  .about-heading-image {
    max-width: 420px;
    margin-bottom: 16px;
  }
  .about-heading-image picture,
  .about-heading-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .about-sub-image {
    max-width: 420px;
  }
  .about-sub-image picture,
  .about-sub-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .intro-line {
    font-size: var(--fs-body-lg);
    max-width: 84ch;
    opacity: 0.92;
  }
  .software-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
  }
  .software-item {
    display: flex;
    align-items: center;
    height: 40px;
    border-radius: 2px;
    overflow: hidden;
    cursor: default;
  }
  .software-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .software-icon {
    width: 18px;
    height: 18px;
    color: var(--red);
  }
  .software-name {
    display: block;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    color: var(--text);
    transition: max-width var(--dur-standard) var(--ease-standard), padding-left var(--dur-standard) var(--ease-standard);
  }
  .software-item:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  .software-item:hover .software-name,
  .software-item:focus .software-name {
    max-width: 160px;
    padding-left: 10px;
  }

  /* Touch devices: hover doesn't apply meaningfully, so keep names visible
     permanently instead of behind a hover gesture. The hover-state
     .software-name padding-left never applies here (hover never triggers
     on touch), so without setting it directly the name rendered flush
     against the icon with no gap at all. */
  @media (hover: none) {
    .software-name {
      max-width: 160px;
      padding-left: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .software-name, .software-item, .software-icon { transition: none; }
  }
  .more-link {
    display: inline-block;
    margin-top: 32px;
    font-size: var(--fs-small);
    color: var(--red);
    letter-spacing: 0.06em;
  }
  .more-link:hover { color: var(--text); }

  @media (max-width: 640px) {
    .about-grid { grid-template-columns: 1fr; }
  }

  /* ---- contact teaser ---- */
  .contact-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .contact-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    line-height: 0.95;
    margin-block: 10px 10px;
    font-style: italic;
    color: var(--text);
  }
  .contact-lede {
    font-size: var(--fs-small);
    color: var(--text-dim);
  }
  .contact-link {
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    color: var(--red);
    white-space: nowrap;
  }
  .contact-link:hover { color: var(--text); }

  @media (max-width: 560px) {
    .contact-inner { align-items: flex-start; }
  }
</style>
