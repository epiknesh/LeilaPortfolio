---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const resume = await getEntry('resume', 'resume');
const { experience, education, skills, courses, overview } = resume!.data;
const siteInfo = await getEntry('siteInfo', 'site');
---

<BaseLayout
  title="Resume"
  description="Resume of Leila Karlene Banta, graphic designer, illustrator, and architecture graduate."
>
  <section class="section no-reveal resume-hero grain">
    <div class="sheet resume-head">
      <div>
        <p class="label">curriculum vitae</p>
        <h1 class="font-stamp">Leila Karlene Banta</h1>
        <p class="font-body role-line">Graphic Designer</p>
      </div>
      <a href="/Leila-Banta-Resume.pdf" download class="download-btn font-mono">download pdf ↓</a>
    </div>
    <div class="sheet contact-strip font-mono">
      <span>{siteInfo!.data.location}</span>
      <span>{siteInfo!.data.phone}</span>
      <a href={`mailto:${siteInfo!.data.email}`}>{siteInfo!.data.email}</a>
      <a href={siteInfo!.data.linkedin} target="_blank" rel="noopener noreferrer">linkedin ↗</a>
    </div>
  </section>

  <section class="section tight-top grain">
    <div class="sheet">
      <p class="label" style="margin-bottom: 20px;">professional overview</p>
      <p class="font-body overview-text">{overview}</p>
    </div>
  </section>

  <section class="section grain bg-alt">
    <div class="sheet">
      <p class="label" style="margin-bottom: 32px;">relevant experience</p>
      <div class="experience-list">
        {experience.map((job) => (
          <article class="job">
            <div class="job-head">
              <div>
                <h3 class="font-stamp job-title">{job.title}</h3>
                {job.org && <p class="font-mono job-org">{job.org}</p>}
              </div>
              <p class="font-mono job-period">{job.period}</p>
            </div>
            <ul class="job-bullets font-body">
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section grain">
    <div class="sheet edu-skills-grid">
      <div>
        <p class="label">education</p>
        {education.map((e) => (
          <div class="edu-item">
            <h3 class="font-stamp edu-degree">{e.degree}</h3>
            <p class="font-mono edu-org">{e.org}</p>
            <p class="font-mono edu-period dim">{e.period}{e.note ? ` · ${e.note}` : ''}</p>
          </div>
        ))}

        <p class="label" style="margin-top: 40px;">courses &amp; certifications</p>
        {courses.map((c) => (
          <div class="edu-item">
            <h3 class="font-stamp edu-degree">{c.name}</h3>
            <p class="font-mono edu-org dim">{c.org} · {c.year}</p>
          </div>
        ))}
      </div>
      <div>
        <p class="label">skills</p>
        <ul class="skills-list font-mono">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 28px;
  }
  .role-line {
    font-size: var(--fs-body-lg);
    font-style: italic;
    color: var(--text-dim);
    margin-top: 6px;
  }
  .download-btn {
    border: 1px solid var(--ink);
    padding: 10px 20px;
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .download-btn:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .contact-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--text-dim);
  }
  .contact-strip a:hover { color: var(--red); }

  .overview-text {
    max-width: 76ch;
    font-size: var(--fs-body-lg);
    opacity: 0.88;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 14px;
    margin-bottom: 12px;
  }
  .job-title {
    font-size: 1.2rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .job-org {
    font-size: var(--fs-small);
    color: var(--text-dim);
    margin-top: 4px;
  }
  .job-period {
    font-size: var(--fs-caption);
    color: var(--text-dim);
    white-space: nowrap;
  }
  .job-bullets {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 72ch;
  }
  .job-bullets li { opacity: 0.85; }

  .edu-skills-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 72px);
  }
  .edu-item { margin-top: 16px; }
  .edu-degree {
    font-size: 1.05rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .edu-org { font-size: var(--fs-small); margin-top: 4px; }
  .edu-period { font-size: var(--fs-caption); margin-top: 2px; }
  .dim { color: var(--text-dim); }

  .skills-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--fs-small);
  }

  @media (max-width: 720px) {
    .edu-skills-grid { grid-template-columns: 1fr; }
  }
</style>
