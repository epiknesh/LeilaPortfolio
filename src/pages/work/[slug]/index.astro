---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { getPublicImageSize, toWebpPath } from '../../../lib/image-size';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project, idx) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(idx - 1 + projects.length) % projects.length],
      next: projects[(idx + 1) % projects.length],
      idx,
      total: projects.length,
    },
  }));
}

const { project, prev, next, idx, total } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const accent = data.palette[0]?.hex ?? '#B32E22';
const heroSize = await getPublicImageSize(data.hero);
---

<BaseLayout
  title={data.title}
  description={data.title}
>
  <article>
    <!-- ============ HERO IMAGE (full width, title overlaid at the bottom) ============ -->
    <section class="section no-reveal hero-image-section">
      <a href="/#work" class="back-link-overlay font-mono">← back to work</a>
      <picture>
        <source srcset={toWebpPath(data.hero)} type="image/webp" />
        <img
          src={data.hero}
          alt={`${data.title}, primary deliverable`}
          width={heroSize.width}
          height={heroSize.height}
          class="hero-image"
          loading="eager"
          decoding="async"
          transition:name={`project-image-${project.id}`}
        />
      </picture>
      <div class="hero-fade" aria-hidden="true"></div>
      <div class="hero-overlay-text">
        <h1 class="font-stamp project-title">{data.title}</h1>
        {data.subtitle && <p class="font-body project-subtitle">{data.subtitle}</p>}
      </div>
    </section>

    <!-- ============ PROJECT DETAILS ============ -->
    <section class="section project-hero grain" style={`--accent: ${accent};`}>
      <div class="sheet">
        <div class="meta-grid font-mono">
          <div>
            <p class="label">project type</p>
            <p>{data.projectType}</p>
          </div>
          <div>
            <p class="label">industry</p>
            <p>{data.industry}</p>
          </div>
          <div>
            <p class="label">deliverables</p>
            <p>{data.deliverables.join(', ')}</p>
          </div>
        </div>

        <a href={`/project-sheets/${project.id}.pdf`} download class="sheet-download font-mono">
          download project sheet ↓
        </a>

        <!-- ============ ABOUT THIS PROJECT (now nested in the details section) ============ -->
        <div class="description-grid">
          <div>
            <p class="label">about this project</p>
          </div>
          <div class="description-copy font-body">
            <Content />

            {data.process && (
              <details class="process-details">
                <summary class="font-mono process-summary">process &amp; references</summary>
                <p class="process-text">{data.process}</p>
              </details>
            )}
          </div>
        </div>

        <!-- ============ COLOR PALETTE (now nested in the details section) ============ -->
        <div class="palette-block">
          <div class="palette-head">
            <p class="label">color palette</p>
            <p class="palette-hint font-mono">click a swatch to copy its hex</p>
          </div>
          <div class="swatch-row" data-palette>
            {data.palette.map((c) => (
              <button type="button" class="swatch" data-swatch={c.hex} aria-label={`Copy hex code ${c.hex}`}>
                <div class="chip" style={`background:${c.hex};`}></div>
                {c.name && <p class="font-mono swatch-name">{c.name}</p>}
                <p class="font-mono swatch-hex" data-swatch-label>{c.hex}</p>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ GALLERY ============ -->
    <section class="section gallery-section grain">
      <div class="sheet">
        <Lightbox images={data.gallery} altPrefix={data.title} />
      </div>
    </section>

    <!-- ============ PREV / NEXT FILMSTRIP ============ -->
    <nav class="section filmstrip grain" aria-label="Project navigation">
      <div class="sheet filmstrip-inner">
        <a href={`/work/${prev.id}/`} class="filmstrip-link font-mono">
          <span class="dim">← prev</span>
          <span class="filmstrip-title font-stamp">{prev.data.title}</span>
        </a>
        <a href="/#work" class="filmstrip-index font-mono">
          {String(idx + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
        </a>
        <a href={`/work/${next.id}/`} class="filmstrip-link font-mono align-right">
          <span class="dim">next →</span>
          <span class="filmstrip-title font-stamp">{next.data.title}</span>
        </a>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .hero-image-section {
    position: relative;
    padding: 0;
    overflow: hidden;
    background: var(--ink);
  }
  .hero-image-section picture {
    display: block;
    width: 100%;
  }

  .back-link-overlay {
    position: absolute;
    top: clamp(16px, 3vw, 28px);
    left: clamp(16px, 3vw, 28px);
    z-index: 2;
    font-size: var(--fs-caption);
    letter-spacing: 0.06em;
    color: #EDE8E0;
    background: rgba(13, 12, 11, 0.4);
    padding: 8px 14px;
    border-radius: 2px;
    backdrop-filter: blur(4px);
    transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .back-link-overlay:hover {
    background: rgba(13, 12, 11, 0.65);
    color: var(--pink);
  }
  .back-link-overlay:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 12, 11, 0.75) 0%, rgba(13, 12, 11, 0) 38%);
    pointer-events: none;
  }

  .hero-overlay-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 48px);
  }

  .project-title {
    font-size: var(--fs-display);
    line-height: 0.95;
    color: #EDE8E0;
  }
  .project-subtitle {
    font-size: var(--fs-body-lg);
    font-style: italic;
    color: #D8D3CB;
    margin-top: 12px;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .meta-grid p:not(.label) {
    font-size: var(--fs-small);
    margin-top: 8px;
    line-height: 1.6;
  }

  .sheet-download {
    display: inline-block;
    margin-top: clamp(28px, 5vw, 48px);
    font-size: var(--fs-caption);
    letter-spacing: 0.06em;
    color: var(--text-dim);
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
  }
  .sheet-download:hover {
    color: var(--red);
    border-color: var(--red);
  }

  .hero-image {
    display: block;
    width: 100%;
    height: clamp(360px, 62vh, 760px);
    object-fit: cover;
    background: var(--bg-alt);
  }

  .description-grid {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: clamp(24px, 5vw, 64px);
    margin-top: clamp(48px, 8vw, 88px);
    padding-top: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line);
  }
  .description-copy p {
    max-width: 68ch;
    font-size: var(--fs-body-lg);
    margin-bottom: 20px;
    opacity: 0.88;
  }
  .description-copy p:last-child { margin-bottom: 0; }

  .process-details {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .process-summary {
    cursor: pointer;
    font-size: var(--fs-caption);
    text-transform: lowercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .process-summary::-webkit-details-marker { display: none; }
  .process-summary::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--red);
  }
  .process-details[open] .process-summary::before {
    content: '−';
  }
  .process-summary:hover { color: var(--red); }
  .process-summary:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
  .process-text {
    margin-top: 14px;
    max-width: 68ch;
    font-size: var(--fs-body);
    opacity: 0.8;
    font-style: italic;
  }

  .palette-block {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line);
  }

  .palette-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .palette-hint {
    font-size: var(--fs-caption);
    color: var(--text-dim);
  }

  .swatch-row {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .swatch {
    width: 120px;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .swatch:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
  .chip {
    height: 80px;
    border-radius: 2px;
    border: 1px solid var(--line);
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .swatch:hover .chip { transform: scale(0.97); }
  .swatch-name { font-size: var(--fs-caption); margin-top: 8px; }
  .swatch-hex {
    font-size: var(--fs-caption);
    color: var(--text-dim);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .swatch.is-copied .swatch-hex { color: var(--red); }
  @media (prefers-reduced-motion: reduce) {
    .chip, .swatch-hex { transition: none; }
    .swatch:hover .chip { transform: none; }
  }

  .filmstrip-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding-block: 8px;
  }
  .filmstrip-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .filmstrip-link.align-right {
    align-items: flex-end;
    text-align: right;
  }
  .filmstrip-link .dim {
    font-size: var(--fs-caption);
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }
  .filmstrip-title {
    font-size: clamp(1rem, 2vw, 1.4rem);
    text-transform: none;
    letter-spacing: 0;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .filmstrip-link:hover .filmstrip-title { color: var(--red); }
  .filmstrip-index {
    font-size: var(--fs-caption);
    color: var(--text-dim);
    letter-spacing: 0.1em;
  }

  @media (max-width: 720px) {
    .meta-grid { grid-template-columns: 1fr; gap: 16px; }
    .description-grid { grid-template-columns: 1fr; }
    .filmstrip-inner {
      grid-template-columns: 1fr;
      text-align: left;
      gap: 14px;
    }
    .filmstrip-link.align-right {
      align-items: flex-start;
      text-align: left;
    }
    .filmstrip-index { order: -1; }
  }
</style>

<script>
  function initPaletteCopy(root: HTMLElement) {
    // Same astro:page-load re-init requirement as Lightbox.astro — see the
    // comment there for the full explanation.
    if (root.dataset.paletteInitialized === 'true') return;
    root.dataset.paletteInitialized = 'true';

    const swatches = root.querySelectorAll<HTMLButtonElement>('[data-swatch]');
    swatches.forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-swatch-label]');
      const hex = btn.getAttribute('data-swatch');
      if (!label || !hex) return;
      const originalText = label.textContent;

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(hex);
        } catch {
          // Clipboard API unavailable (older desktop apps, some webviews) —
          // fall back to selecting the text so the user can copy manually.
          const range = document.createRange();
          range.selectNodeContents(label);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        label.textContent = 'copied!';
        btn.classList.add('is-copied');
        setTimeout(() => {
          label.textContent = originalText;
          btn.classList.remove('is-copied');
        }, 1400);
      });
    });
  }

  function initAllPaletteCopy() {
    document.querySelectorAll<HTMLElement>('[data-palette]').forEach((el) => initPaletteCopy(el.closest('section') ?? el));
  }

  initAllPaletteCopy();
  document.addEventListener('astro:page-load', initAllPaletteCopy);
</script>
