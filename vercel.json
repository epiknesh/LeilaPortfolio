{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "cms/*": false,
      "cms/**": false
    }
  },
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
